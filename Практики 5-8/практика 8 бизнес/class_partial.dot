digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
t [label="{BusinessTrip\nTODO|- id String\l- employee Employee\l- start LocalDate\l- end LocalDate\l- status TripStatus\l- rejectionReason String\l|+ submit()\l+ approve()\l+ reject(String)\l+ cancel()\l+ complete(LocalDate)\l}", fillcolor="#FDE9E7", color="#C00000"];
st [label="{TripStatus||DRAFT\lSUBMITTED\lAPPROVED\lREJECTED\lCANCELLED\lCOMPLETED\l}", fillcolor="#F7FBFF", color="#2F5597"];
sv [label="{BusinessTripService\nTODO||+ create(...) BusinessTrip\l+ findByStatus(TripStatus) List\l}", fillcolor="#FDE9E7", color="#C00000"];
t -> st [label="1",style=dashed,arrowhead=open];
sv -> t [label="manages",style=dashed,arrowhead=open];
}